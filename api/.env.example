# Node
TZ=UTC
PORT=3334
HOST=localhost
NODE_ENV=development

# App
LOG_LEVEL=info
APP_KEY=
APP_URL=http://${HOST}:${PORT}

# CORS (configure allowed origins for API access)
# CORS_ORIGIN=http://localhost:5173,http://localhost:3000

# Plugar.me mock API
PLUGARME_BASE_URL=http://localhost:3333/plugarme/v1
PLUGARME_API_TOKEN=plugarme-test-token

# Amazon mock API
AMAZON_SP_API_BASE_URL=http://localhost:3333/amazon

# Sync defaults
CLIENTE_ID=1
FILIAL_ID=6
HTTP_TIMEOUT_MS=5000
MAX_PRODUCTS_PER_SYNC=1000

# Optional. When configured, POST /sync/amazon/offers requires:
# Authorization: Bearer <SYNC_API_TOKEN>
# SYNC_API_TOKEN=